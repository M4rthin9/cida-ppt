# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgres://cida:cida@localhost:5432/cida
# Replace with output of: openssl rand -base64 32
AUTH_SECRET=change-me-0123456789abcdef0123456789abcdef
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set an absolute writable path on the host. Docker uses /data/media.
MEDIA_DIR=/tmp/cida-ppt-media
# Existing project destination; confirm in CMS LINE settings before launch.
LINE_OA_URL=https://line.me/ti/p/%40355kxfoj

# Optional
# Windows local production review only: skip symlink-based deployment packaging.
# NEXT_STANDALONE=false
# DATABASE_POOL_MAX=10
# DATABASE_MAX_PIPELINE=100
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Production Compose only (see SETUP.md)
# SITE_DOMAIN=your-domain.example
# WEB_IMAGE=ghcr.io/m4rthin9/cida-ppt:sha-<commit>
# POSTGRES_PASSWORD=
